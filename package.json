{
  "name": "nickel-and-dimed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vendor spend tracker: ingest messy invoices, flag vendors whose prices are creeping up.",
  "scripts": {
    "api": "node --env-file=.env server.js",
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "test": "node --test && npm run build",
    "verify:demo": "npm run build:demo && node scripts/verify-demo.mjs",
    "test:sql": "node scripts/run-sql-tests.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
